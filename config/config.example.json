{
  "openai": {
    "apiKey": "",
    "baseUrl": "https://api.openai.com/v1"
  },

  "models": {
    "cheapModel": "gpt-6-luna",
    "balancedModel": "gpt-6-sol",
    "strongModel": "gpt-6-astra",
    "visionModel": "gpt-6-luna"
  },

  "voice": {
    "transcriptionModel": "gpt-4o-mini-transcribe",
    "speechModel": "gpt-4o-mini-tts",
    "voice": "alloy",
